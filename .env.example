# Adapter
LISTEN_ADDR=0.0.0.0:8787
# Comma-separated. The new-api channel key must be one of these.
ADAPTER_API_KEYS=change-me-to-a-long-random-key

# Magpie
MAGPIE_BASE_URL=https://magpie.127001001.xyz
# Re-issue this in Magpie: Gateway -> Gateway keys. The sample below is NOT valid.
MAGPIE_API_KEY=sk-magpie-key-replace-me
# mcp: documented, count 1..20 and fetch. alpha: no MCP for search, no count/fetch.
MAGPIE_SEARCH_MODE=mcp
MAGPIE_MCP_PATH=/mcp/magpie/web-search
MAGPIE_ALPHA_MODEL=magpie-search-adapter
# mcp or off. In alpha search mode, fetch still uses MCP unless this is off.
MAGPIE_FETCH_MODE=mcp

INIT_TIMEOUT=10s
REQUEST_TIMEOUT=60s
FETCH_TIMEOUT=90s
DEFAULT_COUNT=6
MAX_COUNT=20
FETCH_MAX_CHARS=100000
MAX_BODY_BYTES=1048576
MAX_CONCURRENCY=32
LOG_LEVEL=info

# Resilience (search only)
UPSTREAM_RETRIES=2
RETRY_BASE_DELAY=200ms
RETRY_MAX_DELAY=2s
# Whole search including retries; empty means REQUEST_TIMEOUT.
SEARCH_BUDGET=60s
# 0 disables the result cache.
SEARCH_CACHE_TTL=30s
SEARCH_CACHE_SIZE=1024
# Networks allowed to search without a key (SearXNG/Jina clients cannot
# send one). Empty by default; never put a wide range here.
ALLOW_KEYLESS_CIDRS=